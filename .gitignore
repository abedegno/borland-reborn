# Borland toolchains: installed locally by scripts/setup-toolchains.py, never committed
/toolchains/
**/toolchain
# generated from your own BCC.EXE and toolchain by */scripts/prepare.py
**/groupobj/
**/memory_blocks/*.bin
**/linktest/*.OBJ
**/linktest/*.LST
**/linktest/*.LOG
# generated from your own CPP.EXE by bc20/cpp/scripts/prepare.py
/bc20/cpp/src/data/
**/work/
# build output
**/build-source
**/build/
# Python and editor clutter
__pycache__/
*.pyc
.venv/
.DS_Store
._*
bc20/bcc/testsuites
# the port: build output and recorded calls (made from your own BCC.EXE)
bc20/port/build/
bc20/port/records/
